<Window x:Class="SpringClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spring CS2 Loader &amp; Subtick Engine v2.4.1" 
        Height="700" Width="1060"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Foreground="#FFFFFF"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI, Inter, Arial">

    <!-- Outermost Glass Frame with Translucent Acrylic Backdrop and Neon Accent Border -->
    <Border Background="#D00c0c12" BorderBrush="#5584cc16" BorderThickness="1.5" CornerRadius="18" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Color="#84cc16" Opacity="0.25"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/> <!-- Custom Drag Titlebar -->
                <RowDefinition Height="*"/>  <!-- Main Body Layout -->
                <RowDefinition Height="36"/> <!-- Statusbar -->
            </Grid.RowDefinitions>

            <!-- Glass Mesh Ambient Glow Underlay -->
            <Canvas Grid.RowSpan="3" IsHitTestVisible="False">
                <Ellipse Width="340" Height="340" Fill="#1284cc16" Canvas.Left="-60" Canvas.Top="-60">
                    <Ellipse.Effect>
                        <BlurEffect Radius="100"/>
                    </Ellipse.Effect>
                </Ellipse>
                <Ellipse Width="360" Height="360" Fill="#0E06b6d4" Canvas.Right="-60" Canvas.Bottom="-60">
                    <Ellipse.Effect>
                        <BlurEffect Radius="110"/>
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>

            <!-- 1. TRANSLUCENT TITLEBAR -->
            <Border Grid.Row="0" Background="#9912121b" BorderBrush="#25ffffff" BorderThickness="0,0,0,1" MouseDown="TitleBar_MouseDown">
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Brand &amp; Version -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="14" Height="14" CornerRadius="7" Background="#84cc16" Margin="0,0,10,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Color="#84cc16" ShadowDepth="0" Opacity="0.8"/>
                            </Border.Effect>
                        </Border>
                        <TextBlock Text="spring" FontWeight="Bold" FontSize="20" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                        <Border Background="#3384cc16" BorderBrush="#6684cc16" BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="LOADER v2.4.1" FontSize="10" FontWeight="Bold" Foreground="#a3e635"/>
                        </Border>
                    </StackPanel>

                    <!-- Process &amp; VAC Live Status Center -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="StatusDot" Width="8" Height="8" CornerRadius="4" Background="#84cc16" Margin="0,0,6,0"/>
                        <TextBlock x:Name="StatusText" Text="VAC-Live: Undetected (Bypass Active)" FontSize="11" Foreground="#A8A8C0" Margin="0,0,18,0"/>

                        <Border Width="8" Height="8" CornerRadius="4" Background="#06b6d4" Margin="0,0,6,0"/>
                        <TextBlock x:Name="Cs2StatusText" Text="CS2: Scanning for process..." FontSize="11" Foreground="#06b6d4"/>
                    </StackPanel>

                    <!-- Controls: Language switch, Minimize, Close -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnLangToggle" Content="🇬🇧 EN / 🇭🇺 HU" Style="{StaticResource GlassButton}" Padding="10,5" FontSize="11" Margin="0,0,12,0" Click="BtnLangToggle_Click"/>
                        <Button Content="—" Style="{StaticResource GlassButton}" Padding="12,3" FontSize="12" Margin="0,0,6,0" Click="BtnMinimize_Click"/>
                        <Button Content="✕" Style="{StaticResource GlassButton}" Padding="12,3" FontSize="12" Foreground="#fb7185" Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. MAIN BODY: SIDEBAR + TAB CONTENT -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- GLASS SIDEBAR -->
                <Border Grid.Column="0" Background="#80101017" BorderBrush="#20ffffff" BorderThickness="0,0,1,0" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- User Profile Card in Sidebar -->
                        <Border Grid.Row="0" Background="#661c1c28" BorderBrush="#33ffffff" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" Background="#303045" ClipToBounds="True">
                                    <Image Source="mascot_sitting.png" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="LO" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                    <TextBlock x:Name="TxtSubDaysSidebar" Text="● 30 Days Active" FontSize="10" Foreground="#84cc16"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Nav Radio Buttons -->
                        <StackPanel Grid.Row="1">
                            <RadioButton x:Name="NavOverview" Content="⚡ Dashboard &amp; Inject" Style="{StaticResource NavTabButton}" IsChecked="True" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavMovement" Content="🏃 Subtick Movement" Style="{StaticResource NavTabButton}" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavAimbot" Content="🎯 Combat &amp; Aimbot" Style="{StaticResource NavTabButton}" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavVisuals" Content="✨ Visuals &amp; Radar" Style="{StaticResource NavTabButton}" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavInventory" Content="🗡️ Knives &amp; Skins" Style="{StaticResource NavTabButton}" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavHwid" Content="🔒 HWID &amp; License" Style="{StaticResource NavTabButton}" Checked="Nav_Checked"/>
                        </StackPanel>

                        <!-- Angel Mascot Card -->
                        <Border Grid.Row="2" Background="#66181824" BorderBrush="#25ffffff" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,10,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <Image Source="mascot_angel.png" Height="85" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="spring subtick" FontSize="11" FontWeight="SemiBold" Foreground="#a3e635" HorizontalAlignment="Center"/>
                                <TextBlock Text="zero fps overhead" FontSize="9" Foreground="#888899" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- TAB CONTENT VIEWS -->
                <Grid Grid.Column="1" Margin="22,16">

                    <!-- TAB 1: OVERVIEW, GAME LAUNCHER &amp; INJECTION -->
                    <Grid x:Name="TabOverviewView" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header Row -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock x:Name="TxtOverviewTitle" Text="Spring CS2 Loader &amp; Subtick Dashboard" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock x:Name="TxtOverviewSub" Text="Direct memory injection, Steam auto-launch, subtick clock synchronization and live telemetry." FontSize="12" Foreground="#8c8c9e" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Quick Stat Cards -->
                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#66191924" CornerRadius="12" Padding="14" Margin="0,0,10,0" BorderBrush="#22ffffff" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock x:Name="TxtCardSubTitle" Text="SUBSCRIPTION STATUS" FontSize="10" FontWeight="Bold" Foreground="#84cc16"/>
                                    <TextBlock x:Name="TxtCardSubVal" Text="30 Days Active" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="TxtCardSubExp" Text="Expires: 2026-10-05" FontSize="10" Foreground="#7c7c90" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#66191924" CornerRadius="12" Padding="14" Margin="0,0,10,0" BorderBrush="#22ffffff" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock x:Name="TxtCardHwidTitle" Text="HARDWARE LOCK (HWID)" FontSize="10" FontWeight="Bold" Foreground="#06b6d4"/>
                                    <TextBlock x:Name="TxtCardHwidVal" Text="PC-DESKTOP-9X" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="TxtCardHwidStatus" Text="MachineGuid bound" FontSize="10" Foreground="#7c7c90" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#66191924" CornerRadius="12" Padding="14" BorderBrush="#22ffffff" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock x:Name="TxtCardBuildTitle" Text="ENGINE BUILD" FontSize="10" FontWeight="Bold" Foreground="#fb7185"/>
                                    <TextBlock Text="v2.4.1 Subtick Rel" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="TxtCardBuildStatus" Text="VAC-Live bypass active" FontSize="10" Foreground="#7c7c90" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Main Glass Action &amp; Live Console Card -->
                        <Border Grid.Row="2" Background="#73161622" CornerRadius="14" Padding="18" BorderBrush="#2affffff" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtInjectionConsoleTitle" Text="Live Injection &amp; Process Telemetry Console" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF"/>
                                        <TextBlock x:Name="TxtInjectionConsoleSub" Text="Direct 64-bit memory mapping via VirtualAllocEx with 128-tick synchronization." FontSize="11" Foreground="#7c7c90"/>
                                    </StackPanel>
                                    <Button x:Name="BtnClearLogs" Content="Clear Logs" Style="{StaticResource GlassButton}" Padding="8,3" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnClearLogs_Click"/>
                                </Grid>

                                <!-- Transparent Glass Terminal Output Log -->
                                <Border Grid.Row="1" Background="#B309090e" CornerRadius="8" Padding="12" BorderBrush="#33202030" BorderThickness="1">
                                    <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="TxtTerminalLogs" FontFamily="Consolas, JetBrains Mono, Courier New" FontSize="11" Foreground="#a3e635" TextWrapping="Wrap" LineHeight="17"/>
                                    </ScrollViewer>
                                </Border>

                                <!-- Action Controls Bar: Launch CS2, Open Overlay, Inject, Benchmark -->
                                <Grid Grid.Row="2" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtActivePresetStatus" Text="Active Preset: Legit Movement &amp; Bhop v2.1" FontSize="12" Foreground="#D5D5E2"/>
                                        <TextBlock x:Name="TxtInGameHotkey" Text="In-Game Key: Press INSERT to toggle overlay" FontSize="10" Foreground="#78788c"/>
                                    </StackPanel>

                                    <Button x:Name="BtnLaunchCs2" Grid.Column="1" Content="🚀 Launch CS2 (Steam)" Style="{StaticResource GlassButton}" Margin="0,0,8,0" Click="BtnLaunchCs2_Click"/>
                                    <Button x:Name="BtnBenchmark" Grid.Column="2" Content="⏱ Test Latency" Style="{StaticResource GlassButton}" Margin="0,0,8,0" Click="BtnBenchmark_Click"/>
                                    <Button x:Name="BtnOpenOverlayDirect" Grid.Column="3" Content="🎮 Open In-Game Menu" Style="{StaticResource GlassButton}" Margin="0,0,8,0" Click="BtnOpenOverlayDirect_Click"/>
                                    <Button x:Name="BtnInject" Grid.Column="4" Content="⚡ Inject into CS2" Style="{StaticResource PrimaryGlowButton}" Click="BtnInject_Click"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- TAB 2: SUBTICK MOVEMENT -->
                    <Grid x:Name="TabMovementView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock x:Name="TxtMovementHeading" Text="Subtick Movement Engine" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock x:Name="TxtMovementSub" Text="Configure bhop, edge-bug fall rate, jump-bug and pixel surf physics." FontSize="12" Foreground="#858595" Margin="0,3,0,0"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Background="#66161622" CornerRadius="12" Padding="16" Margin="0,0,0,10" BorderBrush="#20ffffff" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Automatic Subtick BunnyHop" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF"/>
                                            <TextBlock Text="Simulates +jump at exact ground collision subtick with zero input delay." FontSize="11" Foreground="#78788a" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkAutoBhop" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ModernSwitch}" IsChecked="True"/>
                                    </Grid>
                                </Border>

                                <Border Background="#66161622" CornerRadius="12" Padding="16" Margin="0,0,0,10" BorderBrush="#20ffffff" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="EdgeBug Helper &amp; Height Predictor" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF"/>
                                            <TextBlock Text="Predicts 4-units edge fall collisions and eliminates velocity fall damage." FontSize="11" Foreground="#78788a" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkEdgeBug" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ModernSwitch}" IsChecked="True"/>
                                    </Grid>
                                </Border>

                                <Border Background="#66161622" CornerRadius="12" Padding="16" Margin="0,0,0,10" BorderBrush="#20ffffff" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="JumpBug Synchronizer" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF"/>
                                            <TextBlock Text="Automatically crouches and jumps 1 tick before landing to preserve momentum." FontSize="11" Foreground="#78788a" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkJumpBug" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ModernSwitch}" IsChecked="True"/>
                                    </Grid>
                                </Border>

                                <Border Background="#66161622" CornerRadius="12" Padding="16" Margin="0,0,0,10" BorderBrush="#20ffffff" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="PixelSurf / Fast Ladder Alignment" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF"/>
                                            <TextBlock Text="Locks camera yaw angle to optimum climb velocity on ladders and surf ramps." FontSize="11" Foreground="#78788a" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkPixelSurf" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ModernSwitch}" IsChecked="True"/>
                                    </Grid>
                                </Border>

                                <Border Background="#66161622" CornerRadius="12" Padding="16" BorderBrush="#20ffffff" BorderThickness="1">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="Subtick Timing Tolerance Window" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                            <TextBlock x:Name="TxtToleranceVal" Text="1.8 ms" FontWeight="Bold" FontSize="13" Foreground="#84cc16" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider x:Name="SliderTolerance" Minimum="0.5" Maximum="4.0" Value="1.8" SmallChange="0.1" Margin="0,10,0,0" ValueChanged="SliderTolerance_ValueChanged"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- TAB 3: COMBAT & AIMBOT -->
                    <Grid x:Name="TabAimbotView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock x:Name="TxtAimbotHeading" Text="Combat &amp; Advanced Aimbot Matrix" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock x:Name="TxtAimbotSub" Text="Precision subtick targeting, independent pitch &amp; yaw recoil compensation, smoothing curves, and backtrack." FontSize="12" Foreground="#858595" Margin="0,3,0,0"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Row 1: Target Bone & Aim Keybind -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#66161622" CornerRadius="12" Padding="14" Margin="0,0,6,0" BorderBrush="#20ffffff" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Target Hitbox" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                                <TextBlock Text="Preferred aimbone selection" FontSize="11" Foreground="#78788a"/>
                                            </StackPanel>
                                            <ComboBox x:Name="CmbTargetBone" Grid.Column="1" Width="110" Background="#20202e" Foreground="#FFFFFF" BorderBrush="#33ffffff" SelectedIndex="0">
                                                <ComboBoxItem Content="Head / Neck"/>
                                                <ComboBoxItem Content="Chest / Body"/>
                                                <ComboBoxItem Content="Nearest Bone"/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="1" Background="#66161622" CornerRadius="12" Padding="14" Margin="6,0,0,0" BorderBrush="#20ffffff" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Aim Keybind" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                                <TextBlock Text="Activation hotkey trigger" FontSize="11" Foreground="#78788a"/>
                                            </StackPanel>
                                            <ComboBox x:Name="CmbAimKey" Grid.Column="1" Width="120" Background="#20202e" Foreground="#FFFFFF" BorderBrush="#33ffffff" SelectedIndex="0">
                                                <ComboBoxItem Content="Always On / Auto"/>
                                                <ComboBoxItem Content="Left Mouse (M1)"/>
                                                <ComboBoxItem Content="Mouse 4 (Side 1)"/>
                                                <ComboBoxItem Content="Mouse 5 (Side 2)"/>
                                                <ComboBoxItem Content="Left Alt"/>
                                                <ComboBoxItem Content="Left Shift"/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Row 2: Visible Check Only & Silent Aim -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#66161622" CornerRadius="12" Padding="14" Margin="0,0,6,0" BorderBrush="#20ffffff" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Visible Check Only" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                                <TextBlock Text="Only aim when raycast confirms target" FontSize="11" Foreground="#78788a"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkVisibleOnly" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ModernSwitch}" IsChecked="True"/>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="1" Background="#66161622" CornerRadius="12" Padding="14" Margin="6,0,0,0" BorderBrush="#20ffffff" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Silent Aim (Subtick Snap)" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                                <TextBlock Text="Invisible client-side camera snap" FontSize="11" Foreground="#78788a"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkSilentAim" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ModernSwitch}" IsChecked="False"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- FOV Slider -->
                                <Border Background="#66161622" CornerRadius="12" Padding="14" Margin="0,0,0,10" BorderBrush="#20ffffff" BorderThickness="1">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="Aimbot Field of View (FOV Cone Radius)" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                            <TextBlock x:Name="TxtFovVal" Text="4.5°" FontWeight="Bold" FontSize="13" Foreground="#84cc16" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider x:Name="SliderFov" Minimum="0.5" Maximum="25.0" Value="4.5" SmallChange="0.5" Margin="0,8,0,0" ValueChanged="SliderFov_ValueChanged"/>
                                    </StackPanel>
                                </Border>

                                <!-- Aim Smoothing & Jitter Matrix -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#66161622" CornerRadius="12" Padding="14" Margin="0,0,6,0" BorderBrush="#20ffffff" BorderThickness="1">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="Aim Smoothing Factor" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                                <TextBlock x:Name="TxtSmoothVal" Text="3.5x" FontWeight="Bold" FontSize="13" Foreground="#06b6d4" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="SliderSmooth" Minimum="1.0" Maximum="10.0" Value="3.5" SmallChange="0.5" Margin="0,8,0,0" ValueChanged="SliderSmooth_ValueChanged"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="#66161622" CornerRadius="12" Padding="14" Margin="6,0,0,0" BorderBrush="#20ffffff" BorderThickness="1">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="Curve Jitter / Randomization" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                                <TextBlock x:Name="TxtJitterVal" Text="5%" FontWeight="Bold" FontSize="13" Foreground="#06b6d4" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="SliderJitter" Minimum="0" Maximum="30" Value="5" SmallChange="1" Margin="0,8,0,0" ValueChanged="SliderJitter_ValueChanged"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Standalone RCS Card with Separate Pitch and Yaw Controls -->
