                                                <Slider x:Name="SliderGloveWear" Minimum="0.0" Maximum="1.0" Value="0.005" SmallChange="0.01" Margin="0,6,0,0" ValueChanged="SliderGloveWear_ValueChanged"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Apply In-Game Button -->
                                <Button x:Name="BtnApplySkins" Content="✨ Apply Skins &amp; Update Weapon Viewmodels" Style="{StaticResource PrimaryGlowButton}" Height="40" FontSize="13" Margin="0,0,0,6" Click="BtnApplySkins_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- TAB 5: CLOUD CONFIGS -->
                    <Grid x:Name="TabConfigsView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="TxtConfigsHeading" Text="Cloud Configuration Sync" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock x:Name="TxtConfigsSub" Text="Seamlessly synchronizes with your spring web panel presets." FontSize="12" Foreground="#858595" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button x:Name="BtnCreateConfig" Content="+ Create Config" Style="{StaticResource GlassButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnCreateConfig_Click"/>
                        </Grid>

                        <ListBox x:Name="LstConfigs" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="LstConfigs_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#66181826" CornerRadius="12" Padding="16" Margin="0,0,0,10" BorderBrush="#22ffffff" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF"/>
                                                    <Border Background="#3384cc16" BorderBrush="#6684cc16" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="Bold" Foreground="#a3e635"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#8c8ca0" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding ShareCode, StringFormat='Cloud Code: {0}'}" FontSize="10" Foreground="#06b6d4" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Load Preset" Style="{StaticResource GlassButton}" VerticalAlignment="Center" Click="BtnLoadPreset_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- TAB 6: HWID &amp; LICENSE -->
                    <Grid x:Name="TabHwidView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock x:Name="TxtHwidHeading" Text="Hardware ID &amp; License Security" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock x:Name="TxtHwidSub" Text="Manage PC registration, active license token, and unbind tokens." FontSize="12" Foreground="#858595" Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1">
                            <Border Background="#66181826" CornerRadius="14" Padding="20" Margin="0,0,0,16" BorderBrush="#22ffffff" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock x:Name="TxtHwidLabel" Text="Registered Hardware Fingerprint (MachineGuid):" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                                    <TextBox x:Name="TxtHwidBox" Text="DESKTOP-9X82F-88A92-SPRING" FontFamily="Consolas" FontSize="13" Background="#800a0a0f" Foreground="#84cc16" BorderBrush="#33ffffff" Padding="12,8" Margin="0,8,0,0" IsReadOnly="True"/>
                                    <TextBlock x:Name="TxtHwidNote" Text="Hardware binding protects your account from unauthorized remote access." FontSize="11" Foreground="#707080" Margin="0,6,0,0"/>
                                    <Button x:Name="BtnResetHwid" Content="🔄 Reset HWID Lock (1 Free Reset Remaining)" Style="{StaticResource GlassButton}" Margin="0,14,0,0" HorizontalAlignment="Left" Click="BtnResetHwid_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#66181826" CornerRadius="14" Padding="20" BorderBrush="#22ffffff" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock x:Name="TxtLicenseLabel" Text="Activate License / Promo Key:" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtLicenseKeyBox" Text="SPRING-30DAY-2026-X89F" FontFamily="Consolas" FontSize="13" Background="#800a0a0f" Foreground="#FFFFFF" BorderBrush="#33ffffff" Padding="12,8"/>
                                        <Button x:Name="BtnActivateKey" Grid.Column="1" Content="Activate Key" Style="{StaticResource PrimaryGlowButton}" Margin="10,0,0,0" Click="BtnActivateKey_Click"/>
                                    </Grid>
                                    <TextBlock x:Name="TxtLicenseStatus" Text="Status: 30 Days Active (Subtick Movement &amp; Dynamic Island)" FontSize="11" Foreground="#84cc16" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- 3. TRANSLUCENT STATUSBAR -->
            <Border Grid.Row="2" Background="#990a0a10" BorderBrush="#20ffffff" BorderThickness="0,1,0,0" Padding="18,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="● spring status:" FontSize="11" Foreground="#7c7c90" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TxtStatusBar" Text="Ready - Waiting for launch command." FontSize="11" Foreground="#a3e635"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="Target: Counter-Strike 2 (DirectX 11 x64) | 128-tick Subtick Engine" FontSize="11" Foreground="#656578"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
