<Window x:Class="SpringClient.InGameOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spring CS2 In-Game Overlay"
        WindowStartupLocation="Manual"
        Left="0" Top="0"
        Width="1920" Height="1080"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        Topmost="True"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Inter, Arial"
        Loaded="Window_Loaded">

    <Grid Background="Transparent">

        <!-- ================================================================= -->
        <!-- IN-GAME VISUAL OVERLAY LAYER (Click-through, only visible when enabled) -->
        <!-- ================================================================= -->
        <Canvas x:Name="HudVisualLayer" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

            <!-- Crosshair Sonar 3D Radar (Hidden by default to avoid screen spam) -->
            <Grid x:Name="CrosshairSonarWidget" Visibility="Collapsed" Canvas.Left="960" Canvas.Top="540" Margin="-80,-80,0,0" Width="160" Height="160">
                <Ellipse Width="150" Height="150" Stroke="#4006b6d4" StrokeThickness="1.2" StrokeDashArray="3 2"/>
                <Ellipse Width="80" Height="80" Stroke="#50fb7185" StrokeThickness="1.2" StrokeDashArray="2 2"/>
                <Line X1="80" Y1="80" X2="80" Y2="5" Stroke="#8084cc16" StrokeThickness="1.5">
                    <Line.RenderTransform>
                        <RotateTransform x:Name="SonarBeamRotation" CenterX="80" CenterY="80" Angle="0"/>
                    </Line.RenderTransform>
                </Line>
                <Ellipse Width="4" Height="4" Fill="#84cc16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- Grenade Lineup Arc Preview (Hidden by default) -->
            <Canvas x:Name="GrenadeLineupCanvas" Visibility="Collapsed" Canvas.Left="960" Canvas.Top="540">
                <Path Stroke="#B384cc16" StrokeThickness="2" StrokeDashArray="3 1.5">
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="0,0">
                                <BezierSegment Point1="50,-80" Point2="150,-120" Point3="260,-40"/>
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                </Path>
                <Border Width="14" Height="14" CornerRadius="7" BorderBrush="#fb7185" BorderThickness="1.5" Margin="253,-47,0,0" Background="#40fb7185">
                    <TextBlock Text="🎯" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Canvas>
        </Canvas>

        <!-- ================================================================= -->
        <!-- FLOATING KEYBINDS LIST HUD WIDGET (Spring CS2 Authentic Visual) -->
        <!-- ================================================================= -->
        <Border x:Name="KeybindsWidget" Visibility="Visible" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0"
                Background="#D90a0a14" BorderBrush="#3384cc16" BorderThickness="1" CornerRadius="10" Padding="12,10" Width="175">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#000000" Opacity="0.8"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="KEYBINDS" FontSize="10" FontWeight="Bold" Foreground="#84cc16" Margin="0,0,0,6"/>
                <Grid Margin="0,2">
                    <TextBlock Text="Auto Bhop" FontSize="10" Foreground="#D5D5E2"/>
                    <TextBlock x:Name="TxtHudBhopStatus" Text="[SPACE]" FontSize="9" FontWeight="Bold" Foreground="#84cc16" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Margin="0,2">
                    <TextBlock Text="EdgeBug" FontSize="10" Foreground="#D5D5E2"/>
                    <TextBlock x:Name="TxtHudEdgeBugStatus" Text="[1.8ms]" FontSize="9" FontWeight="Bold" Foreground="#06b6d4" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Margin="0,2">
                    <TextBlock Text="3rd Person" FontSize="10" Foreground="#D5D5E2"/>
                    <TextBlock x:Name="TxtHudThirdpersonStatus" Text="[V]" FontSize="9" FontWeight="Bold" Foreground="#fb7185" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Margin="0,2">
                    <TextBlock Text="RCS Pitch/Yaw" FontSize="10" Foreground="#D5D5E2"/>
                    <TextBlock x:Name="TxtHudRcsStatus" Text="[75%/65%]" FontSize="9" FontWeight="Bold" Foreground="#f59e0b" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Margin="0,2">
                    <TextBlock Text="Triggerbot" FontSize="10" Foreground="#D5D5E2"/>
                    <TextBlock x:Name="TxtHudTriggerStatus" Text="[25ms]" FontSize="9" FontWeight="Bold" Foreground="#84cc16" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ================================================================= -->
        <!-- COMPACT DYNAMIC ISLAND (Real Spotify & Subtick Status) -->
        <!-- ================================================================= -->
        <Border x:Name="DynamicIslandPill" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
                Background="#E60a0a12" BorderBrush="#3384cc16" BorderThickness="1" CornerRadius="18"
                Padding="12,6" Cursor="Hand" MouseDown="Island_MouseDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#000000" Opacity="0.8"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="8" Height="8" CornerRadius="4" Background="#84cc16" Margin="0,0,8,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" Color="#84cc16" ShadowDepth="0" Opacity="0.9"/>
                    </Border.Effect>
                </Border>
                <TextBlock x:Name="TxtIslandIcon" Text="🎵" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtIslandTitle" Text="Spotify • Searching..." FontWeight="SemiBold" FontSize="11" Foreground="#FFFFFF" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtIslandSub" Text="128-Tick Active" FontSize="10" Foreground="#84cc16" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Bottom Speedometer (Clean & Subtle, Hidden by default) -->
        <Border x:Name="SpeedometerWidget" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24,0,0,24"
                Background="#CC0a0a12" BorderBrush="#25ffffff" BorderThickness="1" CornerRadius="8" Padding="10,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="VELOCITY:" FontSize="9" FontWeight="Bold" Foreground="#06b6d4" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtSpeedVal" Text="250.0 u/s" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ================================================================= -->
        <!-- COMPLETE IN-GAME MASTER SUITE & GLASS MENU (Toggled with INSERT) -->
        <!-- ================================================================= -->
        <Border x:Name="MenuCard" HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="960" Height="600" Background="#F20a0a14" BorderBrush="#5984cc16" BorderThickness="1.2"
                CornerRadius="18" Padding="0" ClipToBounds="True" MouseDown="MenuCard_MouseDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="45" ShadowDepth="0" Color="#000000" Opacity="0.95"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="34"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="#161622" BorderBrush="#25ffffff" BorderThickness="0,0,0,1">
                    <Grid Margin="18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="9" Height="9" CornerRadius="4.5" Background="#84cc16" Margin="0,0,8,0"/>
                            <TextBlock Text="spring" FontWeight="Bold" FontSize="18" Foreground="#FFFFFF"/>
                            <TextBlock Text=" CS2 MASTER CLIENT" FontWeight="Bold" FontSize="11" Foreground="#84cc16" Margin="6,3,0,0"/>
                            <Border Background="#1a84cc16" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                <TextBlock Text="SUBTICK v2.4.1" FontSize="9" FontWeight="Bold" Foreground="#84cc16"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="Press [INSERT] to Hide • CS2 Clicks Pass-Through When Closed" FontSize="11" Foreground="#888899"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnToggleLang" Content="EN / HU" Style="{StaticResource GlassButton}" Padding="10,4" FontSize="10" Margin="0,0,8,0" Click="BtnToggleLang_Click"/>
                            <Button Content="✕ Close" Style="{StaticResource GlassButton}" Padding="12,4" FontSize="11" Foreground="#fb7185" Click="BtnCloseOverlay_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Content Grid -->
                <Grid Grid.Row="1" Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar Navigation -->
                    <Border Grid.Column="0" Background="#101018" CornerRadius="12" Padding="8" BorderBrush="#1a1a24" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <RadioButton x:Name="TabNavDashboard" Content="⚡ Dashboard &amp; Offsets" Style="{StaticResource NavTabButton}" IsChecked="True" Checked="OverlayNav_Checked"/>
                                <RadioButton x:Name="TabNavMovement" Content="🏃 Subtick Movement" Style="{StaticResource NavTabButton}" Checked="OverlayNav_Checked"/>
                                <RadioButton x:Name="TabNavCombat" Content="🎯 Combat &amp; RCS" Style="{StaticResource NavTabButton}" Checked="OverlayNav_Checked"/>
                                <RadioButton x:Name="TabNavVisuals" Content="✨ Visuals &amp; 3rd Person" Style="{StaticResource NavTabButton}" Checked="OverlayNav_Checked"/>
                                <RadioButton x:Name="TabNavSkins" Content="🗡️ Knives &amp; Gloves" Style="{StaticResource NavTabButton}" Checked="OverlayNav_Checked"/>
                                <RadioButton x:Name="TabNavIsland" Content="🏝️ Dynamic Island" Style="{StaticResource NavTabButton}" Checked="OverlayNav_Checked"/>
                            </StackPanel>

                            <!-- Angel Mascot Card -->
                            <Border Grid.Row="1" Background="#161622" CornerRadius="10" Padding="8" Margin="0,10,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <Image Source="mascot_angel.png" Width="68" Height="90" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <Grid>
                                        <TextBlock Text="VAC-LIVE:" FontSize="9" FontWeight="Bold" Foreground="#84cc16"/>
                                        <TextBlock Text="UNDETECTED" FontSize="9" FontWeight="Bold" Foreground="#84cc16" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBlock x:Name="TxtOverlayProcessInfo" Text="CS2: 128-Tick Synced" FontSize="9" Foreground="#06b6d4" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Settings Panels -->
                    <Border Grid.Column="1" Background="#101018" CornerRadius="12" Padding="16" Margin="12,0,0,0" BorderBrush="#1a1a24" BorderThickness="1">
                        <Grid>
                            <!-- 0. DASHBOARD & OFFSETS VIEW -->
                            <ScrollViewer x:Name="ViewDashboard" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock x:Name="TxtOverlayDashTitle" Text="Live In-Game Engine Status &amp; Offsets" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#181824" CornerRadius="8" Padding="12" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="SUBTICK ENGINE STATUS" FontSize="10" FontWeight="Bold" Foreground="#84cc16"/>
                                                <TextBlock x:Name="TxtOverlayHookStatus" Text="Connected &amp; Active" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                                                <TextBlock Text="1ms High-Priority Worker Loop" FontSize="10" Foreground="#888899" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Background="#181824" CornerRadius="8" Padding="12" Margin="6,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="CURRENT OFFSETS SOURCE" FontSize="10" FontWeight="Bold" Foreground="#06b6d4"/>
                                                <TextBlock x:Name="TxtOverlayOffsetsSource" Text="Live GitHub (sezzyaep)" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                                                <TextBlock Text="dwLocalPlayerPawn • dwEntityList" FontSize="10" Foreground="#888899" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Quick Benchmark and Sync -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnOverlaySyncOffsets" Grid.Column="0" Content="🔄 Sync Latest Offsets from GitHub" Style="{StaticResource GlassButton}" Margin="0,0,6,0" Padding="12,8" FontSize="11" Click="BtnOverlaySyncOffsets_Click"/>
                                        <Button x:Name="BtnOverlayBenchmark" Grid.Column="1" Content="⏱ Run In-Game Latency Benchmark" Style="{StaticResource GlassButton}" Margin="6,0,0,0" Padding="12,8" FontSize="11" Click="BtnOverlayBenchmark_Click"/>
                                    </Grid>

                                    <Border Background="#161622" CornerRadius="8" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Active Memory Pointers (Direct Dereferencing):" FontSize="11" FontWeight="Bold" Foreground="#D5D5E2" Margin="0,0,0,6"/>
                                            <TextBlock x:Name="TxtOverlayPointerInfo" Text="• dwLocalPlayerPawn: 0x23CC2A8  |  dwViewMatrix: 0x23D1730&#x0a;• dwEntityList: 0x2576BE0  |  dwCSGOInput: 0x23E07B0" FontSize="11" Foreground="#84cc16" FontFamily="Consolas"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- 1. MOVEMENT VIEW -->
                            <ScrollViewer x:Name="ViewMovement" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock x:Name="TxtOverlayMovTitle" Text="Subtick Movement Tuning" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="Auto BunnyHop (+jump sync on landing tick)" Foreground="#E0E0E8" FontSize="12"/>
                                        <CheckBox x:Name="ChkOverlayBhop" Style="{StaticResource ModernSwitch}" HorizontalAlignment="Right" IsChecked="True" Checked="ChkOverlayMov_Changed" Unchecked="ChkOverlayMov_Changed"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="EdgeBug Velocity Dampener &amp; Predictor" Foreground="#E0E0E8" FontSize="12"/>
                                        <CheckBox x:Name="ChkOverlayEdgeBug" Style="{StaticResource ModernSwitch}" HorizontalAlignment="Right" IsChecked="True" Checked="ChkOverlayMov_Changed" Unchecked="ChkOverlayMov_Changed"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="JumpBug Preservation (crouch on tick before fall)" Foreground="#E0E0E8" FontSize="12"/>
                                        <CheckBox x:Name="ChkOverlayJumpBug" Style="{StaticResource ModernSwitch}" HorizontalAlignment="Right" IsChecked="True" Checked="ChkOverlayMov_Changed" Unchecked="ChkOverlayMov_Changed"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="PixelSurf Ladder Velocity Anchor" Foreground="#E0E0E8" FontSize="12"/>
                                        <CheckBox x:Name="ChkOverlayPixelSurf" Style="{StaticResource ModernSwitch}" HorizontalAlignment="Right" IsChecked="True" Checked="ChkOverlayMov_Changed" Unchecked="ChkOverlayMov_Changed"/>
                                    </Grid>

                                    <Border Background="#181822" CornerRadius="8" Padding="10">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="EdgeBug Timing Tolerance" FontSize="11" Foreground="#FFFFFF"/>
                                                <TextBlock x:Name="TxtOverlayTol" Text="1.8 ms" FontWeight="Bold" FontSize="11" Foreground="#84cc16" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="SliderOverlayTol" Minimum="0.5" Maximum="4.0" Value="1.8" SmallChange="0.1" Margin="0,6,0,0" ValueChanged="SliderOverlayTol_ValueChanged"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- 2. COMBAT VIEW -->
                            <ScrollViewer x:Name="ViewCombat" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock x:Name="TxtOverlayCombatTitle" Text="Combat, Recoil Control &amp; Triggerbot" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Visible Raycast Check Only" Foreground="#E0E0E8" FontSize="12"/>
                                        <CheckBox x:Name="ChkOverlayVisibleOnly" Style="{StaticResource ModernSwitch}" HorizontalAlignment="Right" IsChecked="True"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Silent Aim (Subtick Cam Snap)" Foreground="#E0E0E8" FontSize="12"/>
                                        <CheckBox x:Name="ChkOverlaySilentAim" Style="{StaticResource ModernSwitch}" HorizontalAlignment="Right" IsChecked="False"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Standalone RCS (Recoil Control)" Foreground="#E0E0E8" FontSize="12"/>
                                        <CheckBox x:Name="ChkOverlayRcs" Style="{StaticResource ModernSwitch}" HorizontalAlignment="Right" IsChecked="True" Checked="ChkOverlayRcs_Changed" Unchecked="ChkOverlayRcs_Changed"/>
                                    </Grid>

                                    <!-- Separate Pitch & Yaw RCS -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#181822" CornerRadius="8" Padding="8" Margin="0,0,4,0">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="Pitch RCS (Vertical)" FontSize="11" Foreground="#FFFFFF"/>
                                                    <TextBlock x:Name="TxtOverlayRcsPitchVal" Text="75%" FontWeight="Bold" FontSize="11" Foreground="#fb7185" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Slider x:Name="SliderOverlayRcsPitch" Minimum="0" Maximum="100" Value="75" SmallChange="5" Margin="0,4,0,0" ValueChanged="SliderOverlayRcsPitch_ValueChanged"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1" Background="#181822" CornerRadius="8" Padding="8" Margin="4,0,0,0">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="Yaw RCS (Horizontal)" FontSize="11" Foreground="#FFFFFF"/>
                                                    <TextBlock x:Name="TxtOverlayRcsYawVal" Text="65%" FontWeight="Bold" FontSize="11" Foreground="#fb7185" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Slider x:Name="SliderOverlayRcsYaw" Minimum="0" Maximum="100" Value="65" SmallChange="5" Margin="0,4,0,0" ValueChanged="SliderOverlayRcsYaw_ValueChanged"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Seeded Triggerbot Card -->
                                    <Border Background="#181822" CornerRadius="8" Padding="8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="Seeded Triggerbot (Crosshair Auto-Fire)" Foreground="#E0E0E8" FontSize="11" FontWeight="Bold"/>
                                                <CheckBox x:Name="ChkOverlayTrigger" Style="{StaticResource ModernSwitch}" HorizontalAlignment="Right" IsChecked="True" Checked="ChkOverlayTrigger_Changed" Unchecked="ChkOverlayTrigger_Changed"/>
                                            </Grid>
                                            <Grid Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                    <Grid>
                                                        <TextBlock Text="Reaction Delay" FontSize="10" Foreground="#FFFFFF"/>
                                                        <TextBlock x:Name="TxtOverlayTriggerDelayVal" Text="25 ms" FontWeight="Bold" FontSize="10" Foreground="#f59e0b" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <Slider x:Name="SliderOverlayTriggerDelay" Minimum="0" Maximum="150" Value="25" SmallChange="5" Margin="0,2,0,0" ValueChanged="SliderOverlayTriggerDelay_ValueChanged"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                    <Grid>
                                                        <TextBlock Text="Hitchance" FontSize="10" Foreground="#FFFFFF"/>
                                                        <TextBlock x:Name="TxtOverlayHitchanceVal" Text="85%" FontWeight="Bold" FontSize="10" Foreground="#f59e0b" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <Slider x:Name="SliderOverlayHitchance" Minimum="50" Maximum="100" Value="85" SmallChange="5" Margin="0,2,0,0" ValueChanged="SliderOverlayHitchance_ValueChanged"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- FOV & Smoothing -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#181822" CornerRadius="8" Padding="8" Margin="0,0,4,0">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="FOV Cone" FontSize="11" Foreground="#FFFFFF"/>
                                                    <TextBlock x:Name="TxtOverlayFovVal" Text="4.5°" FontWeight="Bold" FontSize="11" Foreground="#84cc16" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Slider x:Name="SliderOverlayFov" Minimum="0.5" Maximum="25.0" Value="4.5" SmallChange="0.5" Margin="0,4,0,0" ValueChanged="SliderOverlayFov_ValueChanged"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1" Background="#181822" CornerRadius="8" Padding="8" Margin="4,0,0,0">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="Aim Smoothing" FontSize="11" Foreground="#FFFFFF"/>
                                                    <TextBlock x:Name="TxtOverlaySmooth" Text="3.5x" FontWeight="Bold" FontSize="11" Foreground="#06b6d4" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Slider x:Name="SliderOverlaySmooth" Minimum="1.0" Maximum="10.0" Value="3.5" SmallChange="0.5" Margin="0,4,0,0" ValueChanged="SliderOverlaySmooth_ValueChanged"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- 3. VISUALS & 3RD PERSON VIEW -->
                            <ScrollViewer x:Name="ViewVisuals" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock x:Name="TxtOverlayVisTitle" Text="ESP, 3rd Person &amp; Visual Telemetry" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12"/>

                                    <!-- Player ESP Cards -->
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Enemy 2D Bounding Box &amp; Health ESP" Foreground="#E0E0E8" FontSize="12"/>
                                        <CheckBox Style="{StaticResource ModernSwitch}" HorizontalAlignment="Right" IsChecked="True"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Player Skeleton Bone ESP" Foreground="#E0E0E8" FontSize="12"/>
                                        <CheckBox Style="{StaticResource ModernSwitch}" HorizontalAlignment="Right" IsChecked="True"/>
                                    </Grid>

                                    <!-- 3rd Person Perspective Card -->
                                    <Border Background="#181822" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="🎥 3rd Person Perspective View" Foreground="#fb7185" FontWeight="Bold" FontSize="12"/>
                                                <CheckBox x:Name="ChkOverlayThirdperson" Style="{StaticResource ModernSwitch}" HorizontalAlignment="Right" IsChecked="True" Checked="ChkOverlayThirdperson_Changed" Unchecked="ChkOverlayThirdperson_Changed"/>
                                            </Grid>
                                            <TextBlock Text="Over-the-shoulder external camera (Press [V] in-game to toggle)" FontSize="10" Foreground="#78788a" Margin="0,2,0,6"/>
                                            <Grid Margin="0,2,0,0">
                                                <TextBlock Text="Camera Distance" FontSize="11" Foreground="#FFFFFF"/>
                                                <TextBlock x:Name="TxtOverlayThirdpersonDistVal" Text="120 units" FontWeight="Bold" FontSize="11" Foreground="#fb7185" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="SliderOverlayThirdpersonDist" Minimum="40" Maximum="250" Value="120" SmallChange="5" Margin="0,4,0,0" ValueChanged="SliderOverlayThirdpersonDist_ValueChanged"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 3D Footstep Sonar Radar -->
                                    <Border Background="#181822" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="🔊 3D Footstep Sonar Crosshair Radar" Foreground="#06b6d4" FontWeight="Bold" FontSize="12"/>
                                                <CheckBox x:Name="ChkOverlaySoundRadar" Style="{StaticResource ModernSwitch}" HorizontalAlignment="Right" IsChecked="False" Checked="ChkOverlaySoundRadar_Changed" Unchecked="ChkOverlaySoundRadar_Changed"/>
                                            </Grid>
                                            <TextBlock Text="Renders spatial sonar rings for enemy footsteps around crosshair" FontSize="10" Foreground="#78788a" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Grenade Lineup Arc -->
                                    <Border Background="#181822" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="🎯 Grenade Trajectory Lineups" Foreground="#84cc16" FontWeight="Bold" FontSize="12"/>
                                                <CheckBox x:Name="ChkOverlayGrenadeHelper" Style="{StaticResource ModernSwitch}" HorizontalAlignment="Right" IsChecked="False" Checked="ChkOverlayGrenadeHelper_Changed" Unchecked="ChkOverlayGrenadeHelper_Changed"/>
                                            </Grid>
                                            <TextBlock Text="Displays parabolic physics trajectory &amp; jump-throw lineup markers" FontSize="10" Foreground="#78788a" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Speedometer -->
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Velocity Speedometer (Bottom Left)" Foreground="#E0E0E8" FontSize="12"/>
                                        <CheckBox x:Name="ChkOverlaySpeedo" Style="{StaticResource ModernSwitch}" HorizontalAlignment="Right" IsChecked="False" Checked="ChkOverlaySpeedo_Changed" Unchecked="ChkOverlaySpeedo_Changed"/>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- 4. INVENTORY / SKINS VIEW -->
                            <ScrollViewer x:Name="ViewSkins" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock x:Name="TxtOverlaySkinsTitle" Text="Knife &amp; Glove Viewmodel Visualizer" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Enable Client Model Replacer" Foreground="#E0E0E8" FontSize="12"/>
                                        <CheckBox x:Name="ChkOverlaySkinEnable" Style="{StaticResource ModernSwitch}" HorizontalAlignment="Right" IsChecked="True"/>
                                    </Grid>

                                    <TextBlock Text="Active Knife Model:" FontSize="11" Foreground="#9999aa" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbOverlayKnife" Style="{StaticResource GlassComboBox}" SelectedIndex="0" Margin="0,0,0,8">
                                        <ComboBoxItem Content="Karambit • Doppler Phase 2"/>
                                        <ComboBoxItem Content="Butterfly Knife • Fade 100%"/>
                                        <ComboBoxItem Content="M9 Bayonet • Gamma Doppler Emerald"/>
                                        <ComboBoxItem Content="Skeleton Knife • Crimson Web"/>
                                        <ComboBoxItem Content="Talon Knife • Marble Fade"/>
                                        <ComboBoxItem Content="Kukri Knife • Case Hardened Blue Gem"/>
                                    </ComboBox>

                                    <TextBlock Text="Active Gloves:" FontSize="11" Foreground="#9999aa" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbOverlayGloves" Style="{StaticResource GlassComboBox}" SelectedIndex="0" Margin="0,0,0,8">
                                        <ComboBoxItem Content="Sport Gloves • Vice (Factory New)"/>
                                        <ComboBoxItem Content="Sport Gloves • Pandora's Box"/>
                                        <ComboBoxItem Content="Driver Gloves • King Snake"/>
                                        <ComboBoxItem Content="Specialist Gloves • Crimson Kimono"/>
                                        <ComboBoxItem Content="Sport Gloves • Amphibious"/>
                                    </ComboBox>

                                    <Button x:Name="BtnOverlayApplySkins" Content="✨ Apply to CS2 Viewmodel" Style="{StaticResource PrimaryGlowButton}" Height="36" FontSize="12" Click="BtnOverlayApplySkins_Click"/>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- 5. ISLAND HUD VIEW -->
                            <StackPanel x:Name="ViewIsland" Visibility="Collapsed">
                                <TextBlock x:Name="TxtOverlayIslandTitle" Text="Dynamic Island &amp; Spotify Settings" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Show Dynamic Island In-Game" Foreground="#E0E0E8" FontSize="12"/>
                                    <CheckBox x:Name="ChkShowIsland" Style="{StaticResource ModernSwitch}" HorizontalAlignment="Right" IsChecked="True" Checked="ChkShowIsland_Changed" Unchecked="ChkShowIsland_Changed"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Real Spotify Playback Auto-Sync" Foreground="#E0E0E8" FontSize="12"/>
                                    <CheckBox x:Name="ChkSpotifySync" Style="{StaticResource ModernSwitch}" HorizontalAlignment="Right" IsChecked="True"/>
                                </Grid>

                                <Border Background="#161622" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Spotify Windows Player Status:" FontSize="11" FontWeight="Bold" Foreground="#888899" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TxtSpotifyTrackStatus" Text="Listening for Spotify Windows client..." FontSize="12" Foreground="#06b6d4"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Status Bar -->
                <Border Grid.Row="2" Background="#101018" BorderBrush="#1f1f28" BorderThickness="0,1,0,0" Padding="18,0">
                    <Grid VerticalAlignment="Center">
                        <TextBlock x:Name="TxtOverlayFooter" Text="Spring CS2 In-Game Master Suite • Press [INSERT] to toggle anytime" FontSize="11" Foreground="#707080"/>
                        <TextBlock Text="Subtick 128-Tick Active • Zero Click Lag" FontSize="11" Foreground="#84cc16" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
